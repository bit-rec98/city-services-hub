# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.
# Generate strong values, e.g.:  openssl rand -base64 48

# --- PostgreSQL (the admin account is only used to initialise the databases) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# --- Per-service database roles (least privilege; each owns only its own database) ---
IDENTITY_DB_PASSWORD=change-me
APPOINTMENTS_DB_PASSWORD=change-me
NOTIFICATIONS_DB_PASSWORD=change-me

# --- JWT signing key shared by all services (HS256). Minimum 32 bytes. ---
JWT_SECRET_KEY=change-me-use-at-least-32-random-bytes

# --- RabbitMQ (provisioned in docker-compose.yml but not used by the code today) ---
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
