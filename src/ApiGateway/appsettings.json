{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "JwtSettings": {
    "Authority": "http://localhost:5001",
    "Audience": "CityServicesHub"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/auth/login",
        "Period": "1m",
        "Limit": 5
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/auth/{**catch-all}" }
        ]
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/users/{**catch-all}" }
        ]
      },
      "appointments-route": {
        "ClusterId": "appointments-cluster",
        "Match": {
          "Path": "/api/v1/appointments/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/appointments/{**catch-all}" }
        ]
      },
      "health-centers-route": {
        "ClusterId": "appointments-cluster",
        "Match": {
          "Path": "/api/v1/healthcenters/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/healthcenters/{**catch-all}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/notifications/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "appointments-cluster": {
        "Destinations": {
          "appointments": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
